# Application settings
APP_NAME=core-crewsim
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api
APP_PORT=8000
# Comma-separated exact browser origins allowed to call this API directly.
# Production: CORS_ORIGINS=https://bss.crewsim.dev
CORS_ORIGINS=http://localhost:5173

# Database settings. Set these as runtime environment variables in Dokploy.
# The values below are local-development defaults only.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=core_crewsim
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional legacy override. When set, DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/core_crewsim
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/core_crewsim_test

# Redis connection for request logging. An empty REDIS_HOST disables logging.
# Compose Redis runs cache-only (no persistence, LRU eviction).
REDIS_HOST=redis
REDIS_PORT=6379
# Local Compose Redis uses the default user and requires a nonempty password.
REDIS_USERNAME=default
REDIS_PASSWORD=local-redis-password
REDIS_MAXMEMORY=256mb
