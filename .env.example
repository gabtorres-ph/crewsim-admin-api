# Application settings
APP_NAME=core-crewsim
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api
APP_PORT=8000

# Local Compose database settings. These defaults are for development only.
POSTGRES_DB=core_crewsim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Used when running the application or tests directly on the host.
# Compose constructs its DATABASE_URL with the internal hostname "db" instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/core_crewsim
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/core_crewsim_test
