# Application settings
APP_NAME=core-crewsim
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api
APP_PORT=8000
# Comma-separated exact browser origins allowed to call this API directly.
# Production: CORS_ORIGINS=https://bss.crewsim.dev
CORS_ORIGINS=http://localhost:5173

# Database settings. Set these as runtime environment variables in Dokploy.
# The values below are local-development defaults only.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=core_crewsim
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Host port where Compose publishes the db service (bound to 127.0.0.1).
DB_HOST_PORT=5433

# Optional legacy override. When set, DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/core_crewsim
# pytest database; created on first run inside the Compose db service.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/core_crewsim_test

# Redis connection for request logging. An empty REDIS_HOST disables logging.
# Compose Redis stores inspection records without disk persistence and uses LRU eviction.
REDIS_HOST=redis
REDIS_PORT=6379
# Local Compose Redis uses the default user and requires a nonempty password.
REDIS_USERNAME=default
REDIS_PASSWORD=local-redis-password
REDIS_MAXMEMORY=256mb

# Telcovision provider API endpoint (required, no default), token, and refresh key. Set them as runtime secrets in Dokploy.
TELCOVISION_API_URL=
TELCOVISION_API_TOKEN=
# Shared secret callers send in X-Accounts-Refresh-Key to POST /api/accounts/refresh.
# The route's key check is currently disabled.
ACCOUNTS_REFRESH_KEY=
